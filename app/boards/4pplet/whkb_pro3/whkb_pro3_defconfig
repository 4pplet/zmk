CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y

# Use P0.09 and P0.10 as GPIO instead of NFC
CONFIG_NFCT_PINS_AS_GPIOS=y

# Enable ADC for capacitive sensing
CONFIG_ADC=y

# Enable PWM for buzzer
CONFIG_PWM=y

# Build uf2
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Topre ADC driver
CONFIG_ZMK_KSCAN_TOPRE_ADC=y

# USB CDC-ACM for logging
CONFIG_USB_CDC_ACM=y
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_UART_LINE_CTRL=y

# USB serial logging for debugging
CONFIG_LOG=y
CONFIG_ZMK_USB_LOGGING=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_ZMK_LOG_LEVEL_INF=y
