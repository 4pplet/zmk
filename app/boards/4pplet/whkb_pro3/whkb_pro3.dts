/*
 * Copyright (c) 2025 Stefan Sundin (4pplet)
 * SPDX-License-Identifier: MIT
 *
 * WHKB Pro3 - nRF52840 controller for HHKB Professional Classic
 * Uses ADC-based capacitive sensing instead of comparator
 *
 * Pin mapping (adjust to match actual PCB):
 * - ROW0-3: Row drive outputs
 * - COL_A/B/C: 3-bit column select for HC4051 muxes
 * - U1_EN/U2_EN: Mux enable (active low)
 * - OPAMP_EN: OpAmp enable
 * - DISCHARGE: Capacitor discharge
 * - SENSE: ADC input from OpAmp (P0.02 = AIN0)
 * - LDO_EN: Switch board power
 */

/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "whkb_pro3-pinctrl.dtsi"

/ {
    model = "WHKB Pro3";
    compatible = "applet,whkb-pro3";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &cdc_acm_uart;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-topre-adc";
        status = "okay";

        /* Row drive pins */
        row-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>,   /* ROW0 */
                    <&gpio0 27 GPIO_ACTIVE_HIGH>,   /* ROW1 */
                    <&gpio0 4  GPIO_ACTIVE_HIGH>,   /* ROW2 */
                    <&gpio0 5  GPIO_ACTIVE_HIGH>;   /* ROW3 */

        /* Column select pins (address HC4051 muxes) */
        col-sel-gpios = <&gpio0 6  GPIO_ACTIVE_HIGH>,   /* COL_A */
                        <&gpio0 7  GPIO_ACTIVE_HIGH>,   /* COL_B */
                        <&gpio0 8  GPIO_ACTIVE_HIGH>;   /* COL_C */

        /* Mux enable pins (directly address the mux ~EN pin) */
        u1-en-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;  /* U1 enable (cols 0-7) */
        u2-en-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;  /* U2 enable (cols 8-14) */

        /* OpAmp control */
        opamp-en-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
        discharge-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;

        /* ADC sense input */
        io-channels = <&adc 0>;  /* AIN0 = P0.02 */

        /* Power control for switch board */
        power-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;

        /* Sensing parameters */
        actuation-threshold-mv = <1000>;  /* mV threshold for key press */

        /* Timing parameters (microseconds) */
        row-drive-us = <20>;
        row-settle-us = <80>;
        opamp-settle-us = <22>;
        discharge-us = <7>;
    };

    /* HHKB ANSI Layout - 60 keys */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <4>;
        map = <
        RC(1,0) RC(1,3) RC(1,1) RC(1,2) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,11) RC(1,8) RC(1,9) RC(1,10) RC(1,12) RC(1,14) RC(1,13)
        RC(2,0) RC(2,3) RC(2,1) RC(2,2) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,11) RC(2,8) RC(2,9) RC(2,10) RC(2,12) RC(2,13)
        RC(3,0) RC(3,3) RC(3,1) RC(3,2) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,11) RC(3,8) RC(3,9) RC(3,10) RC(3,13)
        RC(0,0) RC(0,3) RC(0,1) RC(0,2) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,11) RC(0,8) RC(0,9) RC(0,10) RC(0,12) RC(0,14) RC(0,13)
        RC(3,12) RC(3,2)                RC(0,6)                 RC(3,11) RC(3,14)
        >;
    };

    physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "HHKB ANSI";
        transform = <&default_transform>;
        keys = <
            /* Row 0: 15 keys */
            &key_physical_attrs 100 100 0   0   0 0 0
            &key_physical_attrs 100 100 100 0   0 0 0
            &key_physical_attrs 100 100 200 0   0 0 0
            &key_physical_attrs 100 100 300 0   0 0 0
            &key_physical_attrs 100 100 400 0   0 0 0
            &key_physical_attrs 100 100 500 0   0 0 0
            &key_physical_attrs 100 100 600 0   0 0 0
            &key_physical_attrs 100 100 700 0   0 0 0
            &key_physical_attrs 100 100 800 0   0 0 0
            &key_physical_attrs 100 100 900 0   0 0 0
            &key_physical_attrs 100 100 1000 0  0 0 0
            &key_physical_attrs 100 100 1100 0  0 0 0
            &key_physical_attrs 100 100 1200 0  0 0 0
            &key_physical_attrs 100 100 1300 0  0 0 0
            &key_physical_attrs 100 100 1400 0  0 0 0
            /* Row 1: 14 keys */
            &key_physical_attrs 150 100 0   100 0 0 0
            &key_physical_attrs 100 100 150 100 0 0 0
            &key_physical_attrs 100 100 250 100 0 0 0
            &key_physical_attrs 100 100 350 100 0 0 0
            &key_physical_attrs 100 100 450 100 0 0 0
            &key_physical_attrs 100 100 550 100 0 0 0
            &key_physical_attrs 100 100 650 100 0 0 0
            &key_physical_attrs 100 100 750 100 0 0 0
            &key_physical_attrs 100 100 850 100 0 0 0
            &key_physical_attrs 100 100 950 100 0 0 0
            &key_physical_attrs 100 100 1050 100 0 0 0
            &key_physical_attrs 100 100 1150 100 0 0 0
            &key_physical_attrs 100 100 1250 100 0 0 0
            &key_physical_attrs 150 100 1350 100 0 0 0
            /* Row 2: 13 keys */
            &key_physical_attrs 175 100 0   200 0 0 0
            &key_physical_attrs 100 100 175 200 0 0 0
            &key_physical_attrs 100 100 275 200 0 0 0
            &key_physical_attrs 100 100 375 200 0 0 0
            &key_physical_attrs 100 100 475 200 0 0 0
            &key_physical_attrs 100 100 575 200 0 0 0
            &key_physical_attrs 100 100 675 200 0 0 0
            &key_physical_attrs 100 100 775 200 0 0 0
            &key_physical_attrs 100 100 875 200 0 0 0
            &key_physical_attrs 100 100 975 200 0 0 0
            &key_physical_attrs 100 100 1075 200 0 0 0
            &key_physical_attrs 100 100 1175 200 0 0 0
            &key_physical_attrs 225 100 1275 200 0 0 0
            /* Row 3: 13 keys */
            &key_physical_attrs 225 100 0    300 0 0 0
            &key_physical_attrs 100 100 225  300 0 0 0
            &key_physical_attrs 100 100 325  300 0 0 0
            &key_physical_attrs 100 100 425  300 0 0 0
            &key_physical_attrs 100 100 525  300 0 0 0
            &key_physical_attrs 100 100 625  300 0 0 0
            &key_physical_attrs 100 100 725  300 0 0 0
            &key_physical_attrs 100 100 825  300 0 0 0
            &key_physical_attrs 100 100 925  300 0 0 0
            &key_physical_attrs 100 100 1025 300 0 0 0
            &key_physical_attrs 100 100 1125 300 0 0 0
            &key_physical_attrs 175 100 1225 300 0 0 0
            &key_physical_attrs 100 100 1400 300 0 0 0
            /* Row 4: 5 keys (bottom row) */
            &key_physical_attrs 100 100 150  400 0 0 0
            &key_physical_attrs 150 100 250  400 0 0 0
            &key_physical_attrs 600 100 400  400 0 0 0
            &key_physical_attrs 150 100 1000 400 0 0 0
            &key_physical_attrs 100 100 1150 400 0 0 0
        >;
    };

    leds {
        compatible = "gpio-leds";
        led_0: led_1 {
            gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
            status = "okay";
        };
        led_1: led_2 {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
            status = "okay";
        };
    };

    buzzer: buzzer {
        compatible = "pwm-buzzer";
        pwms = <&pwm0 0 PWM_HZ(440) PWM_POLARITY_NORMAL>;
    };

    /*
     * Wake button - dedicated button for waking from deep sleep
     * Similar to HHKB Hybrid's power button functionality
     * TODO: Update pin assignment when PCB design is finalized
     */
    gpio_keys {
        compatible = "gpio-keys";
        wake_button: wake_button {
            gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* Placeholder pin */
        };
    };

    /*
     * Wake trigger - enables the wake button to wake from soft-off/deep sleep
     * This is separate from the accelerometer wake functionality
     */
    wakeup_button_trigger: wakeup_button_trigger {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&wake_button>;
        wakeup-source;
    };

    aliases {
        led1 = &led_0;
        led2 = &led_1;
        buzzer = &buzzer;
        wake-button = &wake_button;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/* ADC for capacitive sensing */
&adc {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;  /* P0.02 */
        zephyr,resolution = <12>;
    };
};

/*
 * ADXL362 accelerometer for wakeup from sleep
 * Uses ec-support-zmk-module from petejohanson
 * Provides alternative wake method alongside dedicated wake button
 * TODO: Update CS and INT pin assignments when PCB design is finalized
 */
&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;  /* Placeholder CS pin */

    wakeup_trigger: wakeup_trigger@0 {
        compatible = "zmk,adxl362-awake-trigger";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <8000000>;
        int1-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;  /* Placeholder INT1 pin */
        int2-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;  /* Same pin - workaround for module macro */
        wakeup-source;
        linked-devices = <&kscan0>;

        /*
         * Accelerometer sensitivity settings - adjust these to tune wake behavior.
         * Threshold values are in milli-g (1000 = 1g). Higher = less sensitive.
         * Time values are in sample periods at 12.5Hz (1 = 80ms).
         */
        normal {
            activity-threshold = <18>;    /* Detect light movement */
            activity-time = <0>;
            inactivity-threshold = <60>;
            inactivity-time = <100>;
        };
        sleep {
            activity-threshold = <47>;    /* Wake threshold: 50=sensitive, 75=default, 150=tap, 250=firm shake */
            activity-time = <1>;          /* Require 80ms sustained movement */
            inactivity-threshold = <500>;
            inactivity-time = <0>;
        };
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
