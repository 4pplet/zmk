if BOARD_WHKB

config ZMK_KEYBOARD_NAME
    default "WHKB"

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

config USB_DEVICE_MANUFACTURER
    default "4pplet"

endif # USB

if BT

config BT_DIS_MANUF
    default "4pplet"

config BT_DIS_MODEL
    default "WHKB"

endif # BT

config BT_CTLR
    default BT

config ZMK_BLE
    default y

config ZMK_USB
    default y

endif # BOARD_WHKB
