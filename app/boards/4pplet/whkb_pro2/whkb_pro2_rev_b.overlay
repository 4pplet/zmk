/*
 * Pin assignments:
 * P0.28 - ADXL362 power control (GPIO-switched VDD for clean POR on warm reboot)
 *
 * Reserved for future implementation (present on PCB, not yet used by firmware):
 * P0.09 - BL_LED backlight LED control (NFC1, freed via CONFIG_NFCT_PINS_AS_GPIOS)
 * P0.31 - BQ24075 Power Good (PGOOD) input (active low when input power present)
 * P1.11 - MAX17048 Alert (active low, battery threshold alerts)
 *
 * P1.13 - Wake button (dedicated button to wake from sleep/soft-off)
 * P1.12 - Bootloader entry button (small PCB button, handled by bootloader - not used by firmware)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "whkb_pro2_rev_b-pinctrl.dtsi"

/* Force Topre power off at boot to allow bootloader entry */
&gpio0 {
    topre_power_hog: topre-power-hog {
        gpio-hog;
        gpios = <29 GPIO_ACTIVE_HIGH>;
        output-low;
    };
};

/ {
    model = "WHKB Pro2 Rev B";
    compatible = "applet,whkb-pro2";

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout;
        zmk,battery = &fuelgauge;
        zmk,studio-rpc-uart = &cdc_acm_uart;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-topre";
        /* Physical connector pinout (left to right, ANSI):
         * Pin 1,2: VCC_REG (3.3V from LDO)
         * Pin 3: P0.13 - KEY (~KEY, directly from comparator)
         * Pin 4: P0.20 - HYS (hysteresis control)
         * Pin 5: P0.17 - BIT0 (Row A)
         * Pin 6: P0.15 - BIT1 (Row B)
         * Pin 7: P0.07 - BIT2 (Row C)
         * Pin 8: P0.12 - BIT3 (Col A)
         * Pin 9: P0.04 - BIT4 (Col B)
         * Pin 10: P0.08 - BIT5 (Col C)
         * Pin 11: P0.06 - STROBE (~D enable)
         * Pin 12,13: GND
         *
         * P0.29 controls the LDO enable (DS8601-33S5) which powers the HHKB board
         */
        gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>,              /* 0: POWER (LDO EN) */
                <&gpio0 13 (GPIO_ACTIVE_LOW|GPIO_PULL_UP)>, /* 1: KEY */
                <&gpio0 20 GPIO_ACTIVE_HIGH>,              /* 2: HYS */
                <&gpio0 17 GPIO_ACTIVE_HIGH>,              /* 3: BIT0 (Row A) */
                <&gpio0 15 GPIO_ACTIVE_HIGH>,              /* 4: BIT1 (Row B) */
                <&gpio0 7 GPIO_ACTIVE_HIGH>,               /* 5: BIT2 (Row C) */
                <&gpio0 12 GPIO_ACTIVE_HIGH>,              /* 6: BIT3 (Col A) */
                <&gpio0 4 GPIO_ACTIVE_HIGH>,               /* 7: BIT4 (Col B) */
                <&gpio0 8 GPIO_ACTIVE_HIGH>,               /* 8: BIT5 (Col C) */
                <&gpio0 6 GPIO_ACTIVE_HIGH>;               /* 9: STROBE */
        /* Timing parameters - using original whkb-zmk-config defaults.
         * Original driver used 6us/5us and worked on Rev A. */
        matrix-relax-us = <6>;
        adc-read-settle-us = <5>;
    };

    /* HHKB ANSI Layout - 60 keys */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <8>;
        map = <
        RC(3,1) RC(3,0) RC(0,0) RC(1,0) RC(1,1) RC(2,0) RC(2,1) RC(4,0) RC(4,1) RC(6,0) RC(6,1) RC(7,0) RC(7,1) RC(5,0) RC(5,1)
        RC(3,2) RC(0,1) RC(0,2) RC(1,3) RC(1,2) RC(2,3) RC(2,2) RC(4,2) RC(4,3) RC(6,2) RC(6,3) RC(7,3) RC(7,2) RC(5,2)
        RC(3,3) RC(0,4) RC(0,3) RC(1,4) RC(1,5) RC(2,4) RC(2,5) RC(4,5) RC(4,4) RC(6,5) RC(6,4) RC(7,4) RC(5,3)
        RC(3,4) RC(0,5) RC(0,6) RC(0,7) RC(1,6) RC(1,7) RC(2,6) RC(4,6) RC(6,6) RC(7,6) RC(7,5) RC(5,5) RC(5,4)
        RC(3,5) RC(3,6)                 RC(3,7)                 RC(5,7) RC(5,6)
        >;
    };

    physical_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "HHKB ANSI";
        transform = <&default_transform>;
        keys = <
            /* Row 0: 15 keys */
            &key_physical_attrs 100 100 0   0   0 0 0
            &key_physical_attrs 100 100 100 0   0 0 0
            &key_physical_attrs 100 100 200 0   0 0 0
            &key_physical_attrs 100 100 300 0   0 0 0
            &key_physical_attrs 100 100 400 0   0 0 0
            &key_physical_attrs 100 100 500 0   0 0 0
            &key_physical_attrs 100 100 600 0   0 0 0
            &key_physical_attrs 100 100 700 0   0 0 0
            &key_physical_attrs 100 100 800 0   0 0 0
            &key_physical_attrs 100 100 900 0   0 0 0
            &key_physical_attrs 100 100 1000 0  0 0 0
            &key_physical_attrs 100 100 1100 0  0 0 0
            &key_physical_attrs 100 100 1200 0  0 0 0
            &key_physical_attrs 100 100 1300 0  0 0 0
            &key_physical_attrs 100 100 1400 0  0 0 0
            /* Row 1: 14 keys */
            &key_physical_attrs 150 100 0   100 0 0 0
            &key_physical_attrs 100 100 150 100 0 0 0
            &key_physical_attrs 100 100 250 100 0 0 0
            &key_physical_attrs 100 100 350 100 0 0 0
            &key_physical_attrs 100 100 450 100 0 0 0
            &key_physical_attrs 100 100 550 100 0 0 0
            &key_physical_attrs 100 100 650 100 0 0 0
            &key_physical_attrs 100 100 750 100 0 0 0
            &key_physical_attrs 100 100 850 100 0 0 0
            &key_physical_attrs 100 100 950 100 0 0 0
            &key_physical_attrs 100 100 1050 100 0 0 0
            &key_physical_attrs 100 100 1150 100 0 0 0
            &key_physical_attrs 100 100 1250 100 0 0 0
            &key_physical_attrs 150 100 1350 100 0 0 0
            /* Row 2: 13 keys */
            &key_physical_attrs 175 100 0   200 0 0 0
            &key_physical_attrs 100 100 175 200 0 0 0
            &key_physical_attrs 100 100 275 200 0 0 0
            &key_physical_attrs 100 100 375 200 0 0 0
            &key_physical_attrs 100 100 475 200 0 0 0
            &key_physical_attrs 100 100 575 200 0 0 0
            &key_physical_attrs 100 100 675 200 0 0 0
            &key_physical_attrs 100 100 775 200 0 0 0
            &key_physical_attrs 100 100 875 200 0 0 0
            &key_physical_attrs 100 100 975 200 0 0 0
            &key_physical_attrs 100 100 1075 200 0 0 0
            &key_physical_attrs 100 100 1175 200 0 0 0
            &key_physical_attrs 225 100 1275 200 0 0 0
            /* Row 3: 13 keys (LShift 2.25u, 10x 1u, RShift 1.75u, Fn 1u) */
            &key_physical_attrs 225 100 0    300 0 0 0
            &key_physical_attrs 100 100 225  300 0 0 0
            &key_physical_attrs 100 100 325  300 0 0 0
            &key_physical_attrs 100 100 425  300 0 0 0
            &key_physical_attrs 100 100 525  300 0 0 0
            &key_physical_attrs 100 100 625  300 0 0 0
            &key_physical_attrs 100 100 725  300 0 0 0
            &key_physical_attrs 100 100 825  300 0 0 0
            &key_physical_attrs 100 100 925  300 0 0 0
            &key_physical_attrs 100 100 1025 300 0 0 0
            &key_physical_attrs 100 100 1125 300 0 0 0
            &key_physical_attrs 175 100 1225 300 0 0 0
            &key_physical_attrs 100 100 1400 300 0 0 0
            /* Row 4: 5 keys (bottom row: 1u LAlt, 1.5u LGui, 6u Space, 1.5u RGui, 1u RAlt) */
            &key_physical_attrs 100 100 150  400 0 0 0
            &key_physical_attrs 150 100 250  400 0 0 0
            &key_physical_attrs 600 100 400  400 0 0 0
            &key_physical_attrs 150 100 1000 400 0 0 0
            &key_physical_attrs 100 100 1150 400 0 0 0
        >;
    };

    buzzer: pwm_buzzer {
        compatible = "pwm-buzzer";
        pwms = <&pwm0 0 1000 PWM_POLARITY_NORMAL>;
        status = "disabled";  /* Verified working - disable for now */
    };

    leds {
        compatible = "gpio-leds";
        led_0: led_1 {
            gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;  /* P1.04 */
            status = "okay";
        };
        led_1: led_2 {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>; /* P0.10 */
            status = "okay";
        };
        led_2: led_3 {
            gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  /* P1.06 */
            status = "okay";
        };
        /* TODO: BL_LED backlight on P0.09 (gpio0 9, NFC1) - add node + driver to implement */
    };

    /*
     * BQ24075 charger status - CHG (P0.30) active low when charging.
     * TODO: PGOOD on P0.31 (gpio0 31, active low when input power present) is also
     * available - add an input + handling to implement.
     */
    charger_status {
        compatible = "gpio-keys";
        chg_pin: chg_pin {
            gpios = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* P0.30 CHG */
            status = "okay";
        };
    };

    /*
     * Wake button (P1.13) - dedicated button to wake from sleep/soft-off.
     * Bootloader entry is a separate PCB button on P1.12, handled by the
     * bootloader, so it is not defined here.
     */
    gpio_keys {
        compatible = "gpio-keys";
        wake_button: wake_button {
            gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* P1.13 */
        };
    };

    /*
     * Wake trigger - enables the wake button to wake from soft-off/deep sleep
     */
    wakeup_button_trigger: wakeup_button_trigger {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&wake_button>;
        wakeup-source;
    };

    aliases {
        led1 = &led_0;
        led2 = &led_1;
        led3 = &led_2;
        buzzer = &buzzer;
        chg-status = &chg_pin;
        wake-button = &wake_button;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/* USB CDC ACM for ZMK Studio */
&usbd {
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/*
 * ADXL362 accelerometer for wakeup from sleep
 * Uses ec-support-zmk-module from petejohanson
 */
&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>; /* P0.03 CS */

    wakeup_trigger: wakeup_trigger@0 {
        compatible = "zmk,adxl362-awake-trigger";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <8000000>;
        int1-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>; /* P1.10 AWAKE */
        int2-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>; /* Same pin - workaround for module macro */
        wakeup-source;
        linked-devices = <&kscan0>;

        /*
         * Accelerometer sensitivity settings - adjust these to tune wake behavior.
         * Threshold values are in milli-g (1000 = 1g). Higher = less sensitive.
         * Time values are in sample periods at 12.5Hz (1 = 80ms).
         */
        normal {
            activity-threshold = <18>;    /* Detect light movement */
            activity-time = <0>;
            inactivity-threshold = <60>;
            inactivity-time = <100>;
        };
        sleep {
            activity-threshold = <47>;    /* Wake threshold: 50=sensitive, 75=default, 150=tap, 250=firm shake */
            activity-time = <1>;          /* Require 80ms sustained movement */
            inactivity-threshold = <500>;
            inactivity-time = <0>;
        };
    };
};

/* I2C for MAX17048 fuel gauge */
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    fuelgauge: max17048@36 {
        compatible = "zmk,maxim-max17048";
        reg = <0x36>;
        /* TODO: ALERT on P1.11 (gpio1 11, active low) - not used by driver yet */
    };
};
